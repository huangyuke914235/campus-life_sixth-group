# 生产环境配置样例（域名 campus-life.ccwu.cc，Cloudflare 托管）
#
# 用法：复制为 .env 后替换所有 CHANGE_ME。
# 密钥生成：openssl rand -base64 48

NODE_ENV=production
APP_NAME=shiguang
APP_DOMAIN=campus-life.ccwu.cc
TZ=Asia/Shanghai

# ── 数据库（compose 内部网络，不对外）──
DATABASE_URL=postgresql://shiguang:CHANGE_ME_DB_PASSWORD@postgres:5432/shiguang?schema=public
POSTGRES_USER=shiguang
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
POSTGRES_DB=shiguang

REDIS_URL=redis://redis:6379
REDIS_HOST=redis
REDIS_PORT=6379

# ── 端口 ──
API_PORT=3001
WEB_PORT=3000
API_PREFIX=/api/v1
# 关键：用相对路径，浏览器与页面同域，Cloudflare 换域名也不用改
NEXT_PUBLIC_API_BASE_URL=/api/v1
WEB_ORIGIN=https://campus-life.ccwu.cc

# ── 认证 ──
JWT_ACCESS_SECRET=CHANGE_ME_ACCESS_SECRET
JWT_REFRESH_SECRET=CHANGE_ME_REFRESH_SECRET
JWT_ACCESS_TTL=900s
JWT_REFRESH_TTL=7d
# Cloudflare 已提供 HTTPS，Cookie 必须带 Secure
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
# 留空使用当前访问的主机名。
COOKIE_DOMAIN=
CSRF_ENABLED=true
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
LOGIN_RATE_LIMIT_MAX=10

# ── 存储 ──
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=/app/uploads
# S3 配置为后续接入预留，当前上传保存在 uploads 数据卷。
S3_ENDPOINT=
S3_BUCKET=shiguang-dishes
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=auto
MAX_UPLOAD_BYTES=5242880
ALLOWED_IMAGE_MIME=image/png,image/jpeg,image/webp

# ── 支付（演示：到店付款）──
PAYMENT_PROVIDER=mock
PAYMENT_MODE_LABEL=演示模式 · 到店付款
PAYMENT_MOCK_CONFIRM=true
# 设为 true 暂停新增预约，已存在订单仍可履约或取消。
ORDER_BOOKING_PAUSED=false

# ── 推荐引擎（本地算法，无需外部 Key）──
RECO_PROVIDER=local
RECO_WEIGHT_TASTE=0.30
RECO_WEIGHT_DIET=0.20
RECO_WEIGHT_FEEDBACK=0.15
RECO_WEIGHT_DISH_QUALITY=0.10
RECO_WEIGHT_BUDGET=0.10
RECO_WEIGHT_MEAL_SUPPLY=0.10
RECO_WEIGHT_DIVERSITY=0.05
RECO_LEARNING_RATE=0.12
RECO_DECAY_HALF_LIFE_DAYS=30
RECO_MAX_REPEAT_DAYS=3

# ── 演示数据 ──
# 演示数据由独立开发环境显式初始化。
ENABLE_DEMO_ACCOUNTS=false
DEMO_STUDENT_A_EMAIL=student.a@demo.shiguang.local
DEMO_STUDENT_B_EMAIL=student.b@demo.shiguang.local
DEMO_MERCHANT_EMAIL=merchant@demo.shiguang.local
DEMO_ADMIN_EMAIL=admin@demo.shiguang.local
SEED_DEMO_DATA=false

# ── Cloudflare Tunnel（方案 A 必填，方案 B 留空）──
CLOUDFLARE_TUNNEL_TOKEN=

NUTRITION_DATA_NOTICE=营养数值为示例或估算值，非实验室检测结果
