# ─────────────────────────────────────────────────────────────
# 食光有数 · 环境变量样例
# 复制为 .env（开发）或按部署手册注入生产环境变量。
# 演示凭据仅用于本地体验，生产部署必须替换或关闭。
# ─────────────────────────────────────────────────────────────

# 基础
NODE_ENV=development
APP_NAME=shiguang
TZ=Asia/Shanghai

# 数据库（PostgreSQL）
DATABASE_URL=postgresql://shiguang:shiguang_dev@localhost:5432/shiguang?schema=public
POSTGRES_USER=shiguang
POSTGRES_PASSWORD=shiguang_dev
POSTGRES_DB=shiguang

# Redis（BullMQ 队列 / 限流 / 缓存）
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# 服务端口
API_PORT=3001
WEB_PORT=3000
API_PREFIX=/api/v1
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api/v1

# 认证 —— 生产必须使用 32 字节以上随机值，且不得复用样例值
JWT_ACCESS_SECRET=change-me-to-a-random-32-byte-access-secret
JWT_REFRESH_SECRET=change-me-to-a-random-32-byte-refresh-secret
JWT_ACCESS_TTL=900s
JWT_REFRESH_TTL=7d
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
CSRF_ENABLED=true
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# 限流
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
LOGIN_RATE_LIMIT_MAX=10

# 对象存储（MinIO / S3 兼容）。开发环境可用本地磁盘适配器。
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./uploads
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=shiguang-dishes
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
MAX_UPLOAD_BYTES=5242880
ALLOWED_IMAGE_MIME=image/png,image/jpeg,image/webp

# 支付 —— 第一版仅「到店付款 / 模拟支付」，明确标记为演示模式
PAYMENT_PROVIDER=mock
PAYMENT_MODE_LABEL=演示模式 · 到店付款
PAYMENT_MOCK_CONFIRM=true

# 推荐引擎（本地算法，无需任何外部 API Key）
RECO_PROVIDER=local
RECO_WEIGHT_TASTE=0.30
RECO_WEIGHT_DIET=0.20
RECO_WEIGHT_FEEDBACK=0.15
RECO_WEIGHT_DISH_QUALITY=0.10
RECO_WEIGHT_BUDGET=0.10
RECO_WEIGHT_MEAL_SUPPLY=0.10
RECO_WEIGHT_DIVERSITY=0.05
RECO_LEARNING_RATE=0.12
RECO_DECAY_HALF_LIFE_DAYS=30
RECO_MAX_REPEAT_DAYS=3

# 预留扩展（留空即不启用，核心功能不受影响）
LLM_API_KEY=
LLM_RECOMMENDATION_PROVIDER=
EMBEDDING_PROVIDER=
CAMPUS_SSO_ENDPOINT=
CAMPUS_CARD_ENDPOINT=
SMS_PROVIDER=
EMAIL_PROVIDER=
WEB_PUSH_VAPID_PUBLIC=
WEB_PUSH_VAPID_PRIVATE=
WECHAT_PAY_MCH_ID=
ALIPAY_APP_ID=

# 演示数据（生产必须设为 false）
ENABLE_DEMO_ACCOUNTS=true
DEMO_STUDENT_A_EMAIL=student.a@demo.shiguang.local
DEMO_STUDENT_B_EMAIL=student.b@demo.shiguang.local
DEMO_MERCHANT_EMAIL=merchant@demo.shiguang.local
DEMO_ADMIN_EMAIL=admin@demo.shiguang.local
DEMO_PASSWORD=
SEED_DEMO_DATA=true

# 营养数据声明
NUTRITION_DATA_NOTICE=营养数值为示例或估算值，非实验室检测结果
